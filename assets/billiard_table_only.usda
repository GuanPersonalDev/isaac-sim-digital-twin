                def Material "PhysicsMaterial_Cusion" (
                    apiSchemas = ["PhysicsMaterialAPI"]
                )
                {
                    custom uniform bool paused = 0 (
                        customData = {
                            bool nonpersistant = 1
                        }
                        hidden = true
                    )
                    float physics:dynamicFriction = 0.1
                    float physics:restitution = 0.75
                    float physics:staticFriction = 0.1
                }
            }

        }
    }
}

