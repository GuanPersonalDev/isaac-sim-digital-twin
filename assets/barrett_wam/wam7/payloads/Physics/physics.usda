"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "wam"
{
    over "Geometry"
    {
        over "world" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysxArticulationAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0
            # 預設沒有 author 這兩個值時 PhysX 用內建低迭代次數，對這條
            # 7 自由度＋高 stiffness（見下方各關節 drive:angular:physics:stiffness）
            # ＋球桿 FixedJoint 耦合的鏈，在大幅度 joint-space 移動後會數值上
            # 收斂到穩定但錯誤的關節角（實測 wrist_yaw 卡在偏離目標 0.096 rad，
            # 對應末端 cartesian 誤差 23mm，遠超過 5mm 容許誤差且永遠不會自己
            # 收斂）。拉高到 255（PhysX 上限）後同一案例 wrist_yaw 誤差降到
            # 0.006 rad，見 scripts/probe_solver_iterations.py 的量測。
            int physxArticulation:solverPositionIterationCount = 255
            int physxArticulation:solverVelocityIterationCount = 255

            over "wam_base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.1, 0.1, 0.1)
                float physics:mass = 1
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "wam_shoulder_yaw_link" (
                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                )
                {
                    point3f physics:centerOfMass = (-0.00443422, -0.00066489, -0.1289039)
                    float3 physics:diagonalInertia = (0.09044264, 0.11309538, 0.1350893)
                    float physics:mass = 5
                    quatf physics:principalAxes = (-0.51699847, 0.48311555, 0.46681324, 0.53046894)

                    over "wam_shoulder_pitch_link" (
                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                    )
                    {
                        point3f physics:centerOfMass = (-0.00236981, -0.01542114, 0.03105614)
                        float3 physics:diagonalInertia = (0.012645168, 0.01671268, 0.02141954)
                        float physics:mass = 3.8749375
                        quatf physics:principalAxes = (0.6681187, -0.19924715, 0.6920636, 0.18699168)

                        over "wam_upper_arm_link" (
                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                        )
                        {
                            point3f physics:centerOfMass = (0.0068325857, 0.00003309, 0.3924923)
                            float3 physics:diagonalInertia = (0.003134187, 0.05922074, 0.059271775)
                            float physics:mass = 2.2022815
                            quatf physics:principalAxes = (0.55092883, 0.46770865, 0.52677095, 0.44748005)

                            over "wam_forearm_link" (
                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                            )
                            {
                                point3f physics:centerOfMass = (-0.04001488, -0.14271662, -0.00022942)
                                float3 physics:diagonalInertia = (0.0027580538, 0.014828472, 0.015104704)
                                float physics:mass = 0.500168
                                quatf physics:principalAxes = (-0.48525077, 0.45063266, 0.51075363, 0.54826325)

                                over "wam_wrist_yaw_link" (
                                    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                )
                                {
                                    point3f physics:centerOfMass = (0.00008921, 0.00435824, -0.00511217)
                                    float3 physics:diagonalInertia = (-0.000019648227, 0.000075779346, 0.00013267888)
                                    float physics:mass = 1.0537602
                                    quatf physics:principalAxes = (0.9312149, -0.015602528, -0.36355305, 0.020601962)

                                    over "wam_wrist_pitch_link" (
                                        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                    )
                                    {
                                        point3f physics:centerOfMass = (-0.00012262, -0.02468336, -0.01703194)
                                        float3 physics:diagonalInertia = (0.0002340715, 0.00046317003, 0.00055516843)
                                        float physics:mass = 0.51797366
                                        quatf physics:principalAxes = (-0.4430603, 0.55045766, 0.44874498, 0.54710317)

                                        over "wam_wrist_palm_link" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                        )
                                        {
                                            point3f physics:centerOfMass = (0, 0, 0.055)
                                            float3 physics:diagonalInertia = (0.00010851, 0.00010859, 0.00020683)
                                            float physics:mass = 0.08286134
                                            quatf physics:principalAxes = (0.5, 0.5, 0.5, 0.5)

                                            over "wam_wrist_palm_stump_link" (
                                                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                            )
                                            {
                                                float3 physics:diagonalInertia = (1e-7, 1e-7, 1e-7)
                                                float physics:mass = 0.000001
                                                quatf physics:principalAxes = (1, 0, 0, 0)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

