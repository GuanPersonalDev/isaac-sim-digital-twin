"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "wam" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </wam/Physics/wam_wam_fixed_joint>,
        </wam/Physics/wam_base_yaw_joint>,
        </wam/Physics/wam_shoulder_pitch_joint>,
        </wam/Physics/wam_shoulder_yaw_joint>,
        </wam/Physics/wam_elbow_pitch_joint>,
        </wam/Physics/wam_wrist_yaw_joint>,
        </wam/Physics/wam_wrist_pitch_joint>,
        </wam/Physics/wam_palm_yaw_joint>,
        </wam/Physics/wam_wrist_palm_stump_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </wam/Geometry/world/wam_base_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link/wam_upper_arm_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link/wam_upper_arm_link/wam_forearm_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link/wam_upper_arm_link/wam_forearm_link/wam_wrist_yaw_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link/wam_upper_arm_link/wam_forearm_link/wam_wrist_yaw_link/wam_wrist_pitch_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link/wam_upper_arm_link/wam_forearm_link/wam_wrist_yaw_link/wam_wrist_pitch_link/wam_wrist_palm_link>,
        </wam/Geometry/world/wam_base_link/wam_shoulder_yaw_link/wam_shoulder_pitch_link/wam_upper_arm_link/wam_forearm_link/wam_wrist_yaw_link/wam_wrist_pitch_link/wam_wrist_palm_link/wam_wrist_palm_stump_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "wam_base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "wam_shoulder_yaw_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "wam_shoulder_pitch_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wam_upper_arm_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "wam_forearm_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "wam_wrist_yaw_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "wam_wrist_pitch_link" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "wam_wrist_palm_link" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "wam_wrist_palm_stump_link" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "wam_wam_fixed_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wam_base_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wam_shoulder_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wam_shoulder_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wam_elbow_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "wam_wrist_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
